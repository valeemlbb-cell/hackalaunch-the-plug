# Copy to .env and fill in only what you need. .env is gitignored.
# Plugboard runs the entire pipeline with this file absent: dry-run sends, no model,
# no chain. Nothing below is required to reproduce the demo.

# ---------------------------------------------------------------- workspace
# Where campaigns, matches, drafts, deals and the audit log are written.
PLUGBOARD_WORKSPACE=./workspace
# Creator index. Swap for your own file with the same shape as data/creators.seed.json.
PLUGBOARD_CATALOG=./data/creators.seed.json
# The name recorded against every approval. Required to approve anything.
PLUGBOARD_OPERATOR=

# ------------------------------------------------------------------- sending
# dry_run (default) writes .eml files into <workspace>/outbox and sends nothing.
# live additionally requires every SMTP_* value below AND a resolvable recipient.
PLUGBOARD_SEND_MODE=dry_run
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
PLUGBOARD_FROM_ADDRESS=
PLUGBOARD_FROM_NAME=

# ----------------------------------------------------------------------- LLM
# Leave as none to run fully offline. The model may only fill blanks in a parsed
# brief, restyle a draft (safety lines re-checked), and break reply-intent ties.
PLUGBOARD_LLM_PROVIDER=none
PLUGBOARD_LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# -------------------------------------------------------------------- Solana
# Optional deal-terms receipts. devnet / testnet / localnet only - mainnet is refused
# by plugboard/config.py and the process will not start with it.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Path to a solana-keygen JSON array. Never commit this file.
SOLANA_KEYPAIR_PATH=
